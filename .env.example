# Copy to .env (`make env` does this and fills in the secrets). NEVER commit .env.
TAG=dev
HOST_UID=1000
HOST_GID=1000
MLFLOW_TRACKING_URI=http://mlflow:5000
# Set to http://pushgateway:9091 once the monitoring stack exists (Batch 5).
PUSHGATEWAY_URL=
PIPELINE_TRIGGER=manual
# Secrets: `make env` replaces every "change-me" with a random value.
CONTROLLER_TOKEN=change-me
ADMIN_TOKEN=change-me
GRAFANA_ADMIN_PASSWORD=change-me
ID_HASH_SALT=change-me
